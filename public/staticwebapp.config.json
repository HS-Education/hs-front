{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/runtime-config.json", "/*.{css,js,json,png,jpg,jpeg,svg,ico,woff,woff2}"]
  },
  "routes": [
    { "route": "/runtime-config.json", "headers": { "Cache-Control": "no-store" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY"
  }
}
